<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pendulum_grasp_world">

    <!-- Physics settings: 0.002s step size, max speed headless -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0.0</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Sun light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Con lắc: Bệ treo + Dây + Khối -->
    <model name="cube_pendulum">
      <pose>0.14 0.0 0.54 0 0 0</pose> <!-- Tâm bệ treo trên r=0.14m -->

      <!-- Bệ treo cố định -->
      <link name="pedestal_top">
        <static>true</static>
        <pose>0 0 0 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Khớp cầu dây (Ball joint) kết nối bệ treo và dây -->
      <joint name="rope_ball_joint" type="ball">
        <parent>pedestal_top</parent>
        <child>rope_link</child>
        <pose>0 0 0.15 0 0 0</pose> <!-- Khớp nằm ở đầu trên của dây -->
        <axis>
          <dynamics>
            <!-- Tham số con lắc chuẩn v5.0: damping=0.003 (ζ ≈ 0.03), friction=0.0005 -->
            <damping>0.003</damping>
            <friction>0.0005</friction>
          </dynamics>
        </axis>
      </joint>

      <!-- Dây 30 cm -->
      <link name="rope_link">
        <pose>0 0 -0.15 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>3.75e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>3.75e-5</iyy><iyz>0</iyz>
            <izz>1e-7</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.0015</radius><length>0.30</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <!-- Không dùng collision cho dây để tối ưu hiệu năng -->
      </link>

      <!-- Khớp nối cố định đầu dưới dây với khối cube -->
      <joint name="rope_to_cube_joint" type="fixed">
        <parent>rope_link</parent>
        <child>cube_link</child>
        <pose>0 0 -0.15 0 0 0</pose>
      </joint>

      <!-- Khối lập phương 5x5x5 cm (0.1 kg) -->
      <link name="cube_link">
        <pose>0 0 -0.325 0 0 0</pose> <!-- Gắn ngay dưới đầu dây (-0.15 - 0.025 = -0.175) -->
        <inertial>
          <mass>0.100</mass>
          <inertia>
            <ixx>4.167e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.167e-5</iyy><iyz>0</iyz>
            <izz>4.167e-5</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.2 1</ambient>
            <diffuse>0.1 0.7 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

  </world>
</sdf>
